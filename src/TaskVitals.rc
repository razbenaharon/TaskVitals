#include <windows.h>

// Application icon, generated by scripts/make-icon.py.
1 ICON "TaskVitals.ico"

// Keep in step with the project version in CMakeLists.txt; packaging checks it.
1 VERSIONINFO
FILEVERSION 1,8,0,0
PRODUCTVERSION 1,8,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "TaskVitals contributors"
            VALUE "FileDescription", "TaskVitals taskbar CPU and RAM monitor"
            VALUE "FileVersion", "1.8.0"
            VALUE "InternalName", "TaskVitals"
            VALUE "LegalCopyright", "Copyright (c) 2026 TaskVitals contributors. MIT License."
            VALUE "OriginalFilename", "TaskVitals.exe"
            VALUE "ProductName", "TaskVitals"
            VALUE "ProductVersion", "1.8.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
